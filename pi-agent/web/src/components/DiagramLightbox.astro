---
// Same-origin SVG injection, diagram/code anchors, and an accessible zoom viewer.
---

<style is:global>
#diagram-lightbox { position: fixed; inset: 0; display: none; z-index: var(--lb-z); }
#diagram-lightbox.is-open { display: block; }
#diagram-lightbox .lb-backdrop { position: absolute; inset: 0; background: var(--lb-backdrop-bg); }
#diagram-lightbox .lb-tools {
  position: absolute;
  top: max(12px, env(safe-area-inset-top));
  left: 12px;
  right: 12px;
  display: flex;
  justify-content: center;
  gap: 8px;
}
#diagram-lightbox .lb-tools button {
  min-width: 44px;
  min-height: 44px;
  padding: 6px 12px;
  background: var(--lb-btn-bg);
  border: var(--lb-border-w) solid var(--lb-btn-border);
  border-radius: var(--radius-md);
  color: var(--lb-btn-fg);
  font-size: 16px;
  cursor: pointer;
  touch-action: manipulation;
}
#diagram-lightbox .lb-tools button:disabled { opacity: 0.4; cursor: default; }
#diagram-lightbox .lb-viewport {
  position: absolute;
  top: 76px;
  bottom: max(12px, env(safe-area-inset-bottom));
  left: 12px;
  right: 12px;
  overflow: auto;
  overscroll-behavior: contain;
  display: flex;
}
#diagram-lightbox .lb-img {
  flex: none;
  display: block;
  margin: auto;
  max-width: none;
  max-height: none;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-3);
}
</style>

<script>
  function inlineSvgDiagrams() {
    const imgs = document.querySelectorAll<HTMLImageElement>('figure.diagram img[src$=".svg"]:not([data-inlined])');
    imgs.forEach(img => {
      const src = img.src;
      if (!src || new URL(src).origin !== location.origin) return;
      img.dataset.inlined = 'loading';
      fetch(src, { credentials: 'same-origin' })
        .then(response => {
          if (!response.ok) throw new Error('SVG fetch ' + response.status);
          return response.text();
        })
        .then(text => {
          if (!img.isConnected) return;
          const doc = new DOMParser().parseFromString(text.trim(), 'image/svg+xml');
          const svg = doc.querySelector('svg');
          if (!svg || doc.querySelector('parsererror')) throw new Error('Invalid SVG');
          if (img.alt) {
            svg.setAttribute('role', 'img');
            svg.setAttribute('aria-label', img.alt);
          }
          svg.classList.add('diagram-inline-svg');
          svg.setAttribute('data-src', src);
          img.dataset.inlined = '1';
          img.style.display = 'none';
          img.parentNode!.insertBefore(svg, img);
          const trackingWindow = window as Window & { __diagramInlineCount__?: number };
          trackingWindow.__diagramInlineCount__ = (trackingWindow.__diagramInlineCount__ || 0) + 1;
          document.dispatchEvent(new CustomEvent('diagram:inline'));
        })
        .catch(error => {
          delete img.dataset.inlined;
          console.warn('[DiagramLightbox] SVG inline failed for', src, error);
        });
    });
  }

  function setupLightbox() {
    if (document.querySelector('#diagram-lightbox')) return;
    const lb = document.createElement('div');
    lb.id = 'diagram-lightbox';
    lb.setAttribute('role', 'dialog');
    lb.setAttribute('aria-modal', 'true');
    lb.setAttribute('aria-label', '放大查看图片');
    lb.innerHTML = `
      <div class="lb-backdrop"></div>
      <div class="lb-tools">
        <button class="lb-zoom-out" aria-label="缩小图片">−</button>
        <button class="lb-fit" aria-label="适应屏幕">适应屏幕</button>
        <button class="lb-zoom-in" aria-label="放大图片">+</button>
        <button class="lb-close" aria-label="关闭">×</button>
      </div>
      <div class="lb-viewport" tabindex="0" aria-label="图片，可滚动查看放大后的内容">
        <img class="lb-img" alt="" />
      </div>
    `;
    document.body.appendChild(lb);
    const backdrop = lb.querySelector('.lb-backdrop') as HTMLElement;
    const viewport = lb.querySelector('.lb-viewport') as HTMLElement;
    const img = lb.querySelector('.lb-img') as HTMLImageElement;
    const closeBtn = lb.querySelector('.lb-close') as HTMLButtonElement;
    const zoomIn = lb.querySelector('.lb-zoom-in') as HTMLButtonElement;
    const zoomOut = lb.querySelector('.lb-zoom-out') as HTMLButtonElement;
    const fitBtn = lb.querySelector('.lb-fit') as HTMLButtonElement;
    let lastFocused: HTMLElement | null = null;
    let zoom = 1;
    let fitScale = 1;

    const setZoom = (next: number) => {
      if (!img.naturalWidth || !img.naturalHeight) return;
      const previous = zoom;
      const maximum = Math.max(3, 1 / fitScale);
      zoom = Math.min(maximum, Math.max(1, next));
      const centerX = viewport.scrollLeft + viewport.clientWidth / 2;
      const centerY = viewport.scrollTop + viewport.clientHeight / 2;
      // Change layout dimensions rather than transforms, so touch scrolling reaches every edge.
      img.style.width = `${img.naturalWidth * fitScale * zoom}px`;
      img.style.height = `${img.naturalHeight * fitScale * zoom}px`;
      viewport.scrollLeft = zoom === 1 ? 0 : centerX * zoom / previous - viewport.clientWidth / 2;
      viewport.scrollTop = zoom === 1 ? 0 : centerY * zoom / previous - viewport.clientHeight / 2;
      zoomOut.disabled = zoom <= 1;
      zoomIn.disabled = zoom >= maximum;
    };
    const fitImage = () => {
      if (!lb.classList.contains('is-open') || !img.naturalWidth || !img.naturalHeight) return;
      fitScale = Math.min(1, viewport.clientWidth / img.naturalWidth, viewport.clientHeight / img.naturalHeight);
      setZoom(1);
      img.style.visibility = 'visible';
    };
    const open = (src: string, trigger: Element) => {
      lastFocused = (trigger.closest('.diagram-viewport') || document.activeElement) as HTMLElement;
      img.alt = trigger.closest('figure')?.getAttribute('aria-label') || '图示';
      img.style.visibility = 'hidden';
      lb.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      zoom = 1;
      img.onload = fitImage;
      img.src = src;
      if (img.complete) fitImage();
      closeBtn.focus();
    };
    const close = () => {
      lb.classList.remove('is-open');
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    document.addEventListener('click', event => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const figure = target.closest('figure.diagram');
      if (!figure || target.closest('a, [data-anchor]')) return;
      const svg = figure.querySelector('svg[data-src]');
      const original = figure.querySelector('img');
      const src = svg?.getAttribute('data-src') || original?.src;
      if (src) open(src, target);
    });
    zoomIn.addEventListener('click', () => setZoom(zoom + 0.5));
    zoomOut.addEventListener('click', () => setZoom(zoom - 0.5));
    fitBtn.addEventListener('click', fitImage);
    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    viewport.addEventListener('click', event => {
      if (event.target === viewport && event.offsetX < viewport.clientWidth && event.offsetY < viewport.clientHeight) close();
    });
    img.addEventListener('wheel', event => {
      event.preventDefault();
      setZoom(zoom + (event.deltaY < 0 ? 0.1 : -0.1));
    }, { passive: false });
    window.addEventListener('resize', fitImage);
    document.addEventListener('keydown', event => {
      if (!lb.classList.contains('is-open')) return;
      if (event.key === 'Escape') { close(); return; }
      if (event.key === 'Tab') {
        const controls = Array.from(lb.querySelectorAll<HTMLElement>('button:not(:disabled), [tabindex="0"]'));
        const first = controls[0];
        const last = controls[controls.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      }
    });
  }

  inlineSvgDiagrams();
  setupLightbox();
  document.addEventListener('astro:page-load', () => {
    inlineSvgDiagrams();
    setupLightbox();
  });
</script>
